{
  "log": {
    "loglevel": "warning"
  },
  "api": {
    "tag": "api",
    "services": [
      "HandlerService",
      "LoggerService",
      "StatsService"
    ]
  },
  "dns": {
    "servers": [
      "127.0.0.1"
    ]
  },
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      {
        "type": "field",
        "domain": [
          "full:www.gstatic.com"
        ],
        "outboundTag": "freedom"
      },
      {
        "type": "field",
        "domain": [
          "geosite:cn",
          "geosite:google@cn",
          "domain:cn",
          "domain:google.cn",
          "domain:googleapis.cn",
          "domain:g.cn",
          "domain:googlecnapps.cn",
          "domain:gkecnapps.cn",
          "domain:gstatic.cn",
          "domain:gstaticcnapps.cn",
          "domain:googleapis-cn.com",
          "domain:googleapps-cn.com",
          "domain:gstatic-cn.com",
          "domain:gvt1-cn.com",
          "domain:gvt2-cn.com",
          "domain:googleflights-cn.net",
          "domain:google-analytics-cn.com",
          "domain:googleadservices-cn.com",
          "domain:googlesyndication-cn.com",
          "domain:googletagmanager-cn.com",
          "domain:googletagservices-cn.com",
          "domain:googletraveladservices-cn.com",
          "domain:googleoptimize-cn.com",
          "domain:doubleclick-cn.net",
          "domain:2mdn-cn.net",
          "domain:googleads-cn.com",
          "domain:googlevads-cn.com",
          "domain:recaptcha-cn.net"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "domain": [
          "geosite:google",
          "googleapis.com",
          "full:gstatic.com",
          "golang.org",
          "dl.google.com",
          "ipleak.net",
          "browserleaks.com",
          "iplark.com",
          "ipdata.co",
          "ippure.com"
        ],
        "outboundTag": "freedom"
      },
      {
        "type": "field",
        "ip": [
          "geoip:cn"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "protocol": [
          "bittorrent"
        ],
        "outboundTag": "blocked"
      },
      {
        "type": "field",
        "network": "udp",
        "port": "3478,5349,19302-19309,443",
        "outboundTag": "blocked"
      },
      {
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api",
        "type": "field"
      }
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true
    }
  },
  "inbounds": [],
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "freedom"
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {
        "response": {
          "type": "none"
        }
      }
    }
  ],
  "transport": null,
  "stats": {},
  "reverse": null,
  "fakeDns": null
}
